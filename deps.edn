;; NOT loaded by the local babashka runtime (dev runs use bb.edn). This file
;; pins the engine version for the `-Sdeps` packaged distribution (carded), and
;; it is the classpath a `bbin install` wrapper resolves — hence the runtime
;; deps mirror bb.edn's and :paths carries resources/default-config.edn.
;;
;; The engine is a Maven coordinate now, so bb-depsolve no longer manages it:
;; its rewrite regex only matches :git/tag immediately before :git/sha. Bump
;; :mvn/version by hand when the engine releases.
{:paths ["src" "resources"]

 ;; vtranslate-engine is published to the vtranslate org's PRIVATE registry
 ;; past 0.1.2, so `clojure -T:build` cannot even create a basis for this
 ;; project without knowing where to look. bb.edn's classpath has no engine on
 ;; it, which is why `bb test` needs none of this and the release does.
 ;; Credentials come from a server entry in ~/.m2/settings.xml, and maven pairs
 ;; them to a repository BY ID, so the id here and the id there have to agree.
 ;; BOTH ids name the same url for the reason vtranslate-engine's own deps.edn
 ;; declares both: the credential on a working machine was issued as
 ;; `hive-gitea`, while CI writes `vtranslate-gitea`.
 :mvn/repos {"vtranslate-gitea"
             {:url "https://gitea.hive-mcp.com/api/packages/vtranslate/maven"}
             "hive-gitea"
             {:url "https://gitea.hive-mcp.com/api/packages/vtranslate/maven"}}

 :deps {metosin/malli {:mvn/version "0.20.1"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.19"}
        io.github.hive-agi/hive-di {:mvn/version "0.4.6"}
        io.github.buddhilw/vtranslate-engine {:mvn/version "0.1.28"}}

 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy           {:mvn/version "0.2.5"}}
          :ns-default build}
  :test {:extra-paths ["test"] :extra-deps {io.github.hive-agi/hive-test {:mvn/version "0.4.5"} org.clojure/test.check {:mvn/version "1.1.1"} babashka/fs {:mvn/version "0.5.26"} babashka/process {:mvn/version "0.6.25"} org.babashka/cli {:mvn/version "0.8.67"}} :main-opts ["-m" "vtranslate.cli.test-runner"]}}}
