;; NOT loaded by the babashka runtime (the CLI runs on bb via bb.edn). This file
;; exists so bb-depsolve has a git coordinate to manage: when the engine releases
;; a new tag, `bb sync --org BuddhiLW --apply` (run from the vtranslate/ root)
;; rewrites the :git/tag + :git/sha below. It also pins the engine version for
;; the future `-Sdeps` packaged distribution (carded).
;;
;; bb-depsolve's coordinate regex REQUIRES :git/tag immediately before :git/sha.
{:paths ["src"]
 :deps {metosin/malli {:mvn/version "0.16.4"}
        io.github.BuddhiLW/vtranslate-engine {:git/tag "v0.1.0" :git/sha "cd7477e"}}}
