;; NOT loaded by the local babashka runtime (dev runs use bb.edn). This file
;; pins the engine version for the `-Sdeps` packaged distribution (carded), and
;; it is the classpath a `bbin install` wrapper resolves — hence the runtime
;; deps mirror bb.edn's and :paths carries resources/default-config.edn.
;;
;; The engine is a Maven coordinate now, so bb-depsolve no longer manages it:
;; its rewrite regex only matches :git/tag immediately before :git/sha. Bump
;; :mvn/version by hand when the engine releases.
{:paths ["src" "resources"]
 :deps {metosin/malli {:mvn/version "0.20.1"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.10"}
        io.github.hive-agi/hive-di {:mvn/version "0.4.1"}
        io.github.buddhilw/vtranslate-engine {:mvn/version "0.1.1"}}

 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                 slipset/deps-deploy           {:mvn/version "0.2.5"}}
          :ns-default build}}}
