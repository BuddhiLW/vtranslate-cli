;; vtranslate CLI — a babashka wrapper over vtranslate-engine. One driving
;; adapter: parse argv -> read/mutate ~/.config/vtranslate/config.edn -> build a
;; job spec -> shell the engine subprocess -> format its EDN Result. The engine
;; (a sibling JVM project) owns all domain logic + provider resolution; the CLI
;; owns argv, config-file editing, and output formatting.
{:paths ["src" "resources"]
 :deps  {;; Result monad — the CLI threads the same railway as the engine.
         io.github.hive-agi/hive-dsl
         {:git/tag "v0.5.1" :git/sha "335869e023e1bd5bf57c72be881baa647edf4a78"}
         ;; EDN config IO with 0600 perm-hardening (read-edn / write-edn! :secret?).
         io.github.hive-agi/hive-di
         {:local/root "../hive-di"}}
 ;; babashka.cli / babashka.fs / babashka.process are built into bb — no dep.
 :tasks {vtranslate {:doc      "vtranslate CLI — config + provider + run"
                     :requires ([vtranslate.cli.main])
                     ;; forward the raw trailing args to -main (exec would swallow them)
                     :task     (apply vtranslate.cli.main/-main *command-line-args*)}}}
