;; vtranslate CLI — a babashka wrapper over vtranslate-engine. Two driving
;; adapters over one core: parse argv (or serve HTTP) -> read/mutate
;; ~/.config/vtranslate/config.edn -> build a job spec -> shell the engine
;; subprocess -> format its EDN Result. The engine (a sibling JVM project) owns
;; all domain logic + provider resolution; the CLI owns argv, config-file
;; editing, and output formatting.
;; `bb web` serves the local control panel over the same core.
{:paths ["src" "resources"]
 :deps  {;; Result monad — the CLI threads the same railway as the engine.
         io.github.hive-agi/hive-dsl {:mvn/version "0.5.2"}
         ;; malli - plain metosin schema for the transport JobSpec boundary guard (bb-compatible).
         metosin/malli {:mvn/version "0.16.4"}
         ;; EDN config IO with 0600 perm-hardening (read-edn / write-edn! :secret?).
         ;; A machine-local :local/root override belongs in local.deps.edn
         ;; (gitignored) — never a host-absolute path in a tracked file.
         io.github.hive-agi/hive-di {:mvn/version "0.4.0"}}
 ;; babashka.cli / babashka.fs / babashka.process are built into bb — no dep.
 ;; bbin install io.github.BuddhiLW/vtranslate-cli reads this entry point; the
 ;; installed wrapper resolves the classpath from deps.edn, NOT from :deps here.
 :bbin/bin {vtranslate {:main-opts ["-m" "vtranslate.cli.main"]}}
 :tasks {vtranslate {:doc      "vtranslate CLI — config + provider + run"
                     :requires ([vtranslate.cli.main])
                     ;; forward the raw trailing args to -main (exec would swallow them)
                     :task     (apply vtranslate.cli.main/-main *command-line-args*)}
         web {:doc      "local control panel on 127.0.0.1 (default port 7777)"
              :requires ([vtranslate.cli.web.server])
              :task     (apply vtranslate.cli.web.server/-main *command-line-args*)}
         test {:doc      "run the test suite (clojure.test)"
               :requires ([clojure.test])
               :task     (do
                           (babashka.classpath/add-classpath "test")
                           (let [nses '[vtranslate.cli.main-test
                                        vtranslate.cli.engine-boundary-test
                                        vtranslate.cli.engine-test
                                        vtranslate.cli.config-doctor-test
                                        vtranslate.cli.config-secret-test
                                        vtranslate.cli.config-provider-secret-test
                                        vtranslate.cli.job-spec-test
                                        vtranslate.cli.web.dialog-test
                                        vtranslate.cli.web.job-test
                                        vtranslate.cli.web.routes-test
                                        vtranslate.cli.web.runner-test
                                        vtranslate.cli.adapters.addon-classpath.local-deps-test]]
                             (apply require nses)
                             (let [s (apply clojure.test/run-tests nses)]
                               (System/exit (if (pos? (+ (:fail s) (:error s))) 1 0)))))}}}
